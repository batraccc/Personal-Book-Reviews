<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/styles.css">
    <title>My Library</title>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>My Book Reviews</h1>
            <p>List of all the books I'ev read, their review and rating</p>
        </div>
        <div class="reviews">
            <div class="reviews-constants">
                <h2>My reviews</h2>
                <a href="/search"><button>Add</button></a>
            </div>
            <% if(locals.reviews) {%>
                <% reviews.forEach(review => { %>
                    <div class="review">
                        <div class="book-cover">
                            <img src="<%= review.cover_url %>" alt="book cover">
                        </div>
                        <div class="review-details">
                            <h3>Title: <%= review.book_title %></h3>
                            <h3>Author: <%= review.book_author %></h3>
                            <h3>Published: <%= review.book_publish_year %></h3>
                            <p id="text<%= review.id %>"><%= review.review_text %></p>
                            <form class="edit" action="/edit" method="POST">
                                <input type="hidden" name="book_id" value="<%= review.id %>">
                    
                                <textarea id="input<%= review.id %>"
                                          name="updated_review"
                                          hidden="true"><%= review.review_text %></textarea>
                    
                                <button id="done<%= review.id %>"
                                        type="submit"
                                        hidden="true">Save</button>
                            </form>
                            <p>Rating: <%= review.rating %>/5</p>
                        </div>
                        <div class="action-buttons">
                            <form action="/delete" method="POST">
                                <button value="<%= review.book_id%>" name="delete_button">Delete</button>
                            </form>
                            <button id="edit<%= review.id %>"
                                onclick="editHandler('<%= review.id %>')">
                                Edit
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else {%>
                <h2>No reviews made. Click on the add button to add one!</h2>
            <% } %>
        </div>
    </div>
    <script src="/js/index.js"></script>
</body>
</html>