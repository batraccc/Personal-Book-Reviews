<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/review-style.css">
    <title>Review</title>
</head>
<body>
    <div class="container">
        <div class="book-details">
            <% if(locals.book_data) { %>
                <div class="cover">
                   <img src="https://covers.openlibrary.org/b/id/<%= book_data.cover_id %>-L.jpg" alt="book cover"> 
                </div>
                <div class="other-details">
                    <h2><%= book_data.title %></h2>
                    <h3><%= book_data.author %></h3> 
                    <h4><%= book_data.publish_year %></h4>
                </div>
            <% } %>
        </div>
        <form action="/reviews/save" method="POST" class="review-form">
            <input type="hidden" name="title" value="<%= book_data.title %>">
            <input type="hidden" name="author" value="<%= book_data.author %>">
            <input type="hidden" name="publish_year" value="<%= book_data.publish_year %>">
            <input type="hidden" name="cover_id" value="https://covers.openlibrary.org/b/id/<%= book_data.cover_id %>-L.jpg">
            <input type="hidden" name="key" value="<%= book_data.key %>">

            <div class="review-input">
                <textarea name="review" placeholder="Enter review..." rows="10" autofocus></textarea>
            </div>

            <div class="rating-input">
                <input type="radio" name="rating" id="star-1" value="1">
                <label for="star-1">★</label>

                <input type="radio" name="rating" id="star-2" value="2">
                <label for="star-2">★</label>

                <input type="radio" name="rating" id="star-3" value="3">
                <label for="star-3">★</label>

                <input type="radio" name="rating" id="star-4" value="4">
                <label for="star-4">★</label>

                <input type="radio" name="rating" id="star-5" value="5">
                <label for="star-5">★</label>
            </div>

            <div class="submit-review">
                <button type="submit">Submit Review</button>
            </div>
        </form>
    </div>
</body>
</html>